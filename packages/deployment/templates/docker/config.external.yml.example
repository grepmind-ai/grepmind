app:
  host: 0.0.0.0
  port: 3847
  publicBaseUrl: https://grepmind.example.com
  serverInstanceId: grepmind-self-hosted-1

agentAuth:
  frontendApiUrl: https://<clerk-frontend-api>
  cliOAuthClientId: <clerk-cli-oauth-client-id>

clerk:
  publishableKey: ""

database:
  host: <postgres-host>
  port: 5432
  name: grepmind
  user: grepmind

storage:
  endPoint: <s3-endpoint>
  port: 443
  useSSL: true
  bucket: <s3-bucket>
  prefix: artifacts

embedding:
  provider: voyage
  model: voyage-code-3

docsEmbedding:
  provider: voyage
  model: voyage-context-3

reranker:
  provider: voyage
  model: rerank-2
