write_grepmind_env() {
  umask 077
  {
    printf "GREPMIND_IMAGE=%s\n" "$(quote_shell "$GREPMIND_IMAGE")"
    printf "GREPMIND_TAG=%s\n" "$(quote_shell "$GREPMIND_TAG")"
    printf "CLERK_SECRET_KEY=%s\n" "$(quote_shell "$CLERK_SECRET_KEY")"
    printf "VOYAGE_API_KEY=%s\n" "$(quote_shell "$VOYAGE_API_KEY")"
    printf "DATABASE_URL=%s\n" "$(quote_shell "$DATABASE_URL")"
    printf "GREPMIND_S3_ACCESS_KEY=''\n"
    printf "GREPMIND_S3_SECRET_KEY=''\n"
  } > /opt/grepmind/.env
  chmod 600 /opt/grepmind/.env
}
