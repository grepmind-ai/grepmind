{
  "name": "grepmind",
  "version": "0.1.0-alpha",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "Grepmind packages",
  "type": "module",
  "scripts": {
    "build": "npm run build:agent && npm run build:grepmind",
    "build:agent": "npm -w @grepmind/agent run build",
    "build:grepmind": "npm -w grepmind run build",
    "release:agent": "npm -w @grepmind/agent run release --",
    "release:agent:dry-run": "npm -w @grepmind/agent run release:dry-run",
    "release:grepmind": "npm -w grepmind run release --",
    "release:grepmind:dry-run": "npm -w grepmind run release:dry-run",
    "clean": "npm -ws run clean --if-present",
    "grepmind": "node packages/grepmind/src/index.js",
    "agent": "npm -w @grepmind/agent run dev:cli --"
  },
  "author": "Zaytra",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaytra-labs/grepmind.git"
  },
  "homepage": "https://github.com/zaytra-labs/grepmind#readme",
  "bugs": {
    "url": "https://github.com/zaytra-labs/grepmind/issues"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "esbuild": "^0.27.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
